.DS_Store
Thumbs.db

# Secrets (if you later add them)
.env
.env.*

# Local tooling / editor
.vscode/
.venv/
__pycache__/
*.pyc

# One-off scripts with personal data
update_winners_leads.js

# Admin scripts that require SERVICE_ROLE_KEY (never commit to git)
update_*.py
check_*.py
debug_*.py
fix_*.py
apply_*.py
*_interactive.py

# Large raw source files (keep private/local)
data/*.docx
data/*.xlsx

# Generated extraction artifacts (keep private/local)
scripts/*.out.json
scripts/*_generated.json
scripts/source_extract*.json

# Local data-extraction scripts (keep private/local)
scripts/*.py

# Winners payloads used for seeding (keep private/local)
data/winners-*.json
data/*winners*.json
data/temp-upload-*.json
winners-*.json
winners_payload*.json
section_*_content.json

# All temporary JSON data files (load from Supabase only)
temp*.json

# Generated reports / operational outputs (may contain tokens or PII)
reports/
check_results.txt
link_check_full.txt
url_check_results.txt

# Invitation operation artifacts (keep local only)
invite/*Invitation Status.csv
invite/batches_*/
invite/retries/*.csv
invite/retries/**

# Dedicated local-only workspace for sensitive exports/backups
local/**
!local/.gitkeep
!local/README.md
